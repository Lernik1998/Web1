# Configuración para Plesk/Apache (único hosting de destino del proyecto --
# no existen ya archivos equivalentes para Netlify/Vercel).
#
# La CSP es la misma que la del <meta> en index.html más "frame-ancestors"
# (anti-clickjacking), que por especificación solo funciona como cabecera
# real, no por <meta>. Probada en local contra el build de producción: 0
# violaciones navegando por Inicio, Blog (con contenido real de WordPress),
# Equipo, una ficha de terapia y Pedir cita, incluida la carga real de
# reCAPTCHA v3 y la obtención de un token válido.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://kanbouripsicologia.com https://secure.gravatar.com https://lh3.googleusercontent.com; connect-src 'self' https://kanbouripsicologia.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Solo tiene efecto real cuando el navegador ya está viendo el sitio por
  # HTTPS -- actívalo en Plesk (SSL/TLS + "Redirigir de HTTP a HTTPS") para
  # que este dominio empiece a mandar esta cabecera de verdad.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# Los archivos de /assets/ llevan un hash en el nombre (p. ej.
# index-B3n-XD8B.js): si cambia el contenido, cambia el nombre, así que se
# pueden cachear "para siempre" sin riesgo de servir una versión vieja.
<IfModule mod_headers.c>
  <FilesMatch "^assets/.+\.(js|css|woff2?|png|jpe?g|svg|webp|gif|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# index.html sí cambia de contenido con cada despliegue sin cambiar de
# nombre (referencia los assets con hash nuevo cada vez): debe revalidarse
# siempre para que un visitante recurrente reciba la versión publicada.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# SPA (vue-router en modo history): sin esto, entrar directamente a una URL
# como /terapias/adultos/ansiedad o recargar la página ahí devuelve un 404
# real de Apache, porque no existe ningún archivo con ese nombre -- solo
# vue-router, ya cargado en el navegador, sabe resolverla. Esta regla deja
# pasar archivos y carpetas que sí existen (JS, CSS, imágenes, sitemap.xml,
# robots.txt...) tal cual, y todo lo demás lo redirige a index.html para que
# sea vue-router quien decida qué mostrar.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
