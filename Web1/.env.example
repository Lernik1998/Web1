# URL base de la API de WordPress (obligatoria).
VITE_API_BASE_URL=https://kanbouripsicologia.com

# Google Analytics (opcional). Sin esta variable, el gestor de cookies no
# carga ningún script de estadísticas aunque el usuario acepte esa categoría.
VITE_GA_MEASUREMENT_ID=

# Site key de reCAPTCHA v3 (opcional), generada en
# https://www.google.com/recaptcha/admin para este dominio (y "localhost"
# para desarrollo). Sin esta variable, el formulario de Pedir Cita sigue
# funcionando igual que antes, sin verificación anti-bot.
VITE_RECAPTCHA_SITE_KEY=
